<?xml version="1.0" encoding="utf-8"?>
<!-- Identity private keys are stored unencrypted, so they must never leave the device through backups or transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="identities/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="identities/" />
    </device-transfer>
</data-extraction-rules>
